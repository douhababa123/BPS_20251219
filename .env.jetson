# BPS Jetson 部署环境变量配置
# 复制此文件为 .env 并根据实际情况修改

# ========================================
# 数据库配置（SQL Server）
# ========================================
DB_SERVER=10.88.43.154
DB_DATABASE=DCCT_BPS_Debug
DB_USERNAME=TEST
DB_PASSWORD=123456
DB_DRIVER=ODBC Driver 17 for SQL Server

# ========================================
# JWT 安全配置
# ========================================
# 生产环境必须修改为随机密钥！
# 生成命令: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ========================================
# OTP 验证码配置
# ========================================
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6

# ========================================
# SMTP 邮件服务器（用于发送 OTP）
# ========================================
SMTP_HOST=smtp.bosch.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_email@bosch.com
SMTP_PASSWORD=your_email_password

# ========================================
# 应用配置
# ========================================
APP_NAME=BPS API
APP_VERSION=1.0.0
DEBUG=false  # 生产环境设置为 false

# ========================================
# CORS 跨域配置
# ========================================
# 生产环境添加实际域名，例如：
# ALLOWED_ORIGINS=http://10.70.80.183,https://bps.bosch.com
ALLOWED_ORIGINS=http://10.70.80.183

# ========================================
# 允许注册的邮箱域名
# ========================================
ALLOWED_EMAIL_DOMAINS=bosch.com,bshg.com
